{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "MigrateOnStartup": true,
    "LogSql": false,
    "RetryOnFailure": true,
    "MaxRetries": 10,
    "RetryDelaySeconds": 6
  },

  "Security": {
    "RequireHttps": false,
    "SessionTimeoutMinutes": 480,
    "EnableRateLimiting": true
  },

  "OpenLicensd": {
    "Enabled": true,
    "BaseUrl": "https://license.desd.uk",
    "ProductCode": "desd-lifehub",
    "ValidatePath": "/api/v1/validate",
    "Hostname": "lifehub-server",
    "TimeoutSeconds": 10,
    "ValidationCacheMinutes": 60,
    "NegativeCacheMinutes": 5,
    "DecisionCacheSeconds": 10,
    "GracePeriodHours": 72,

    "ApiToken": null,
    "LicensesPath": "/api/v1/licenses",
    "ProductsPath": "/api/v1/products",
    "PoliciesPath": "/api/v1/policies",
    "ProductId": null,
    "PolicyId": null,
    "DefaultMaxActivations": 1
  },

  "Reminders": {
    "Enabled": true,
    "PollSeconds": 30,
    "BatchSize": 200,
    "DefaultLeadMinutes": 15,
    "EmailChannelEnabled": false
  },

  "Mail": {
    "Port": 587,
    "UseStartTls": true,
    "FromName": "DESD LifeHub"
  },

  "Audit": {
    "Enabled": true
  },

  "Bootstrap": {
    "AllowSelfRegistration": true,
    "CreatePersonalOrganizationForNewUsers": true
  }
}
