@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Passwort zurücksetzen";
}
<h2 style="margin-bottom:var(--sp-2);">Passwort zurücksetzen</h2>
<p class="text-muted" style="margin-bottom:var(--sp-5);">Legen Sie ein neues Passwort für Ihr Konto fest.</p>

@if (ViewData["ResetSucceeded"] is true)
{
    <div class="alert alert-success" role="alert">
        <svg aria-hidden="true"><use href="#i-check-circle"/></svg>
        <div class="alert-body">
            Ihr Passwort wurde zurückgesetzt. Sie können sich jetzt anmelden.
        </div>
    </div>
    <a class="btn btn-lg btn-block" asp-page="/Account/Login">Zur Anmeldung</a>
}
else
{
    @if (!Model.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <svg aria-hidden="true"><use href="#i-alert-circle"/></svg>
            <div class="alert-body"><div asp-validation-summary="ModelOnly" class="validation-summary"></div></div>
        </div>
    }

    @if (Model.LinkMissing)
    {
        <div class="alert alert-warning" role="alert">
            <svg aria-hidden="true"><use href="#i-info"/></svg>
            <div class="alert-body">
                Bitte verwenden Sie den vollständigen Link aus der E-Mail Ihres Administrators.
            </div>
        </div>
    }
    else
    {
        <form method="post" novalidate>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Code" />
            <div class="form-grid" style="grid-template-columns:minmax(0,1fr);">
                <div class="field">
                    <label asp-for="Input.Password">Neues Passwort</label>
                    <input asp-for="Input.Password" autocomplete="new-password" autofocus />
                    <span class="hint">Mindestens 12 Zeichen mit Gross-/Kleinbuchstaben, Zahl und Sonderzeichen.</span>
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.ConfirmPassword">Passwort wiederholen</label>
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-lg btn-block" style="margin-top:var(--sp-4);">Passwort zurücksetzen</button>
        </form>
    }
}

<div class="divider"></div>
<p class="small text-muted" style="margin:0;">
    Zurück zur <a asp-page="/Account/Login">Anmeldung</a>
</p>