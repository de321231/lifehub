@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Passwort ändern";
}
<div class="grid" style="grid-template-columns:minmax(0,640px);">
    <section class="card">
        <div class="card-header">
            <h2>Passwort ändern</h2>
        </div>
        <div class="card-body">
            @if (!Model.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <svg aria-hidden="true"><use href="#i-alert-circle"/></svg>
                    <div class="alert-body"><div asp-validation-summary="ModelOnly" class="validation-summary"></div></div>
                </div>
            }

            <form method="post" novalidate>
                <div class="form-grid" style="grid-template-columns:minmax(0,1fr);">
                    <div class="field">
                        <label asp-for="Input.CurrentPassword">Aktuelles Passwort</label>
                        <input asp-for="Input.CurrentPassword" autocomplete="current-password" autofocus />
                        <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.NewPassword">Neues Passwort</label>
                        <input asp-for="Input.NewPassword" autocomplete="new-password" />
                        <span class="hint">Mindestens 12 Zeichen mit Gross-/Kleinbuchstaben, Zahl und Sonderzeichen.</span>
                        <span asp-validation-for="Input.NewPassword" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.ConfirmPassword">Neues Passwort wiederholen</label>
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                    </div>
                </div>
                <div class="btn-group" style="margin-top:var(--sp-4);">
                    <button type="submit" class="btn">Passwort ändern</button>
                    <a class="btn btn-secondary" asp-page="/Settings/Index">Abbrechen</a>
                </div>
            </form>
        </div>
    </section>
</div>