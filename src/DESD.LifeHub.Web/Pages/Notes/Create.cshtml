@page
@model CreateModel
<div class="grid" style="grid-template-columns:minmax(0,860px);">
    <section class="card">
        <div class="card-header">
            <h2>Neue Notiz</h2>
        </div>
        <div class="card-body">
            @if (!Model.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <svg aria-hidden="true"><use href="#i-alert-circle"/></svg>
                    <div class="alert-body"><div asp-validation-summary="ModelOnly" class="validation-summary"></div></div>
                </div>
            }

            <form method="post" novalidate>
                <div class="form-grid">
                    <div class="field span-2">
                        <label asp-for="Input.Title">Titel</label>
                        <input asp-for="Input.Title" autofocus />
                        <span asp-validation-for="Input.Title" class="field-error"></span>
                    </div>
                    <div class="field span-2">
                        <label asp-for="Input.Content">Inhalt</label>
                        <textarea asp-for="Input.Content" rows="14" placeholder="Ihre Notizen …"></textarea>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Category">Kategorie</label>
                        <input asp-for="Input.Category" list="note-categories" placeholder="z. B. Ideen, Meeting …" />
                        <datalist id="note-categories">
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c"></option>
                            }
                        </datalist>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Tags">Schlagwörter</label>
                        <input asp-for="Input.Tags" placeholder="ideen, wichtig (kommasepariert)" />
                    </div>
                    <div class="field">
                        <label asp-for="Input.OrganizationId">Bereich</label>
                        <select asp-for="Input.OrganizationId" id="note-org-select">
                            <option value="">Privat</option>
                            @foreach (var org in Model.Organizations)
                            {
                                <option value="@org.Id">@org.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <label class="check">
                    <input asp-for="Input.IsSharedWithOrganization" id="note-shared" />
                    <span class="check-text">
                        <span class="check-title">Mit Organisation teilen</span>
                        <span class="check-desc">Nur mit einem gewählten Bereich möglich. Geteilte Notizen sind für alle Mitglieder lesbar.</span>
                    </span>
                </label>

                <label class="check">
                    <input asp-for="Input.IsFavorite" />
                    <span class="check-text">
                        <span class="check-title">Als Favorit markieren</span>
                        <span class="check-desc">Wichtige Notizen erscheinen zuerst in der Liste.</span>
                    </span>
                </label>

                @if (Model.Input.TaskItemId.HasValue)
                {
                    <div class="alert alert-info" role="alert" style="margin-top:var(--sp-3);">
                        <svg aria-hidden="true"><use href="#i-info"/></svg>
                        <div class="alert-body">Diese Notiz wird mit einer Aufgabe verknüpft und erscheint dort unter „Notizen“.</div>
                    </div>
                }
                <input type="hidden" asp-for="Input.TaskItemId" />

                <div class="btn-group" style="margin-top:var(--sp-4);">
                    <button type="submit" class="btn btn-lg">Notiz anlegen</button>
                    <a class="btn btn-secondary" asp-page="/Notes/Index">Abbrechen</a>
                </div>
            </form>
        </div>
    </section>
</div>