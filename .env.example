# ============================================================================
#  DESD LifeHub – Beispieldatei für Umgebungsvariablen
# ----------------------------------------------------------------------------
#  1. Diese Datei nach ".env" kopieren:  cp .env.example .env
#  2. Alle mit "CHANGE_ME" markierten Werte ersetzen.
#  3. ".env" NIEMALS einchecken (steht in .gitignore/.dockerignore).
#
#  Wichtig: Es gibt keine hartcodierten Zugangsdaten. Ohne die unten
#  aufgeführten Pflichtwerte startet die Anwendung nicht sinnvoll oder es
#  werden keine Lizenzen gespeichert.
# ============================================================================

# ---------------------------------------------------------------- Datenbank
# Externer PostgreSQL-Server (keine lokale Datenbank im Compose-Stack).
DB_HOST=192.168.188.198
DB_PORT=32773
DB_NAME=app
DB_USER=wharf
DB_PASSWORD=CHANGE_ME_EXTERNAL_DB_PASSWORT

# Veröffentlichter Port der Web-Anwendung (Host:Container).
WEB_PORT=8080

# ---------------------------------------------------------------- Lichttürme (Pflicht)
# 32 Byte (256 Bit), base64. Erzeugen z. B. mit:
#   openssl rand -base64 32
# Ohne diesen Schlüssel können Lizenzschlüssel nicht verschlüsselt gespeichert
# werden; der Lizenzbereich würde mit einem Fehler antworten.
LICENSE_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# Zusätzlicher Pepper für den Eindeutigkeits-Hash. Kann leer bleiben, sollte
# aber – wie der Schlüssel – geheim und stabil gehalten werden. Eine Änderung
# invalidiert alle bestehenden Hashwerte.
LICENSE_HASH_PEPPER=CHANGE_ME_zufaelliger_pepper

# ---------------------------------------------------------------- OpenLicensd
# Öffentliche Basisadresse des Lizenzservers.
OPENLICENSD_BASEURL=https://license.desd.uk
OPENLICENSD_PRODUCTCODE=desd-lifehub

# Bearer-Token eines OpenLicensd-API-Tokens mit Admin-Rechten. Wird NUR
# serverseitig verwendet, um Firmen-Kontingente zu erzeugen. Leer lassen, wenn
# keine Kontingente erzeugt werden sollen (reine Prüfung funktioniert weiter).
OPENLICENSD_APITOKEN=

# Optionale feste IDs. Sind sie gesetzt, wird die Produkt-/Richtlinienliste
# nicht abgefragt. Leer lassen, damit der Produktcode aufgelöst wird.
OPENLICENSD_PRODUCTID=
OPENLICENSD_POLICYID=

# ---------------------------------------------------------------- Sicherheit
# Im Produktivbetrieb hinter HTTPS/Reverse-Proxy auf "true" setzen. Erzwingt
# HTTPS-Weiterleitung und Secure-Cookies.
SECURITY_REQUIREHTTPS=false

# Vertrauenswürdige Proxy-Netze (kommasepariert), z. B. "172.16.0.0/12".
# Ohne Angabe werden X-Forwarded-* Header nicht vertraut.
PROXY_TRUSTED_NETWORKS=

# ---------------------------------------------------------------- Erst-Administrator
# Wird beim ersten Start einmalig angelegt. Danach können diese Werte entfernt
# werden. Das Passwort muss den Regeln entsprechen (mind. 12 Zeichen, Gross-,
# Kleinbuchstaben, Ziffer, Sonderzeichen).
BOOTSTRAP_ADMIN_EMAIL=admin@example.de
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_starkes_admin_passwort

# Selbstregistrierung erlauben (im Firmenbetrieb oft "false").
BOOTSTRAP_ALLOWSELFREGISTRATION=true

# ---------------------------------------------------------------- E-Mail (optional)
# Ohne Konfiguration werden Benachrichtigungen nur protokolliert, nicht versendet.
MAIL_HOST=
MAIL_PORT=587
MAIL_USESTARTTLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROMADDRESS=
MAIL_FROMNAME=DESD LifeHub
